{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/map/stores.js": {
      "includeFiles": "*.json",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/stores", "destination": "/api/proxy?path=stores" },
    { "source": "/api/stores/:path*", "destination": "/api/proxy?path=stores/:path*" },
    { "source": "/stores/:path*", "destination": "/index.html" }
  ]
}
